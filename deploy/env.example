# Copy this file to .env in the project root when enabling domain HTTPS.
# Use a hostname only: no scheme, path, port, or trailing slash.
SITE_DOMAIN=cyberhome.wuhuxiaoshu.com
APP_PORT=3000
BACKUP_KEEP=14

# Optional: a Chat Completions-compatible model service. Leave blank to keep
# original-text capture and sharing without AI. Never commit a real key.
COMPANION_AI_BASE_URL=
COMPANION_AI_MODEL=
COMPANION_AI_KEY=
