[Unit]
Description=Our Garden private two-person space
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=ourgarden
Group=ourgarden
WorkingDirectory=/opt/our-garden
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-old-space-size=128
Environment=HOST=127.0.0.1
Environment=PORT=3000
Environment=DATA_DIR=/var/lib/our-garden
Environment=COOKIE_SECURE=true
Environment=PUBLIC_ORIGIN=https://cyberhome.wuhuxiaoshu.com
ExecStart=/opt/our-garden-runtime/bin/node /opt/our-garden/server.mjs
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
UMask=0077
StateDirectory=our-garden
StateDirectoryMode=0700
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/our-garden
CapabilityBoundingSet=
MemoryAccounting=true
MemoryMax=384M
CPUQuota=100%
TasksMax=100
StandardOutput=journal
StandardError=journal
SyslogIdentifier=our-garden

[Install]
WantedBy=multi-user.target
